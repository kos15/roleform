{
  "name": "roleform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma migrate deploy && pnpm db:policies && next build --turbopack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "script": "tsx --tsconfig tsconfig.scripts.json",
    "db:policies": "pnpm script scripts/db/apply-policies.ts",
    "db:schedule": "pnpm script scripts/db/schedule.ts",
    "seed:catalog": "pnpm script scripts/catalog/seed-catalog.ts",
    "bundles:rebuild": "pnpm script scripts/catalog/rebuild-bundles.ts",
    "grant:admin": "pnpm script scripts/db/grant-admin.ts",
    "push:keys": "pnpm script scripts/ops/push-keys.ts",
    "icons": "pnpm script scripts/ops/app-icons.ts",
    "check:constraints": "pnpm script scripts/db/smoke-constraints.ts",
    "check:fabrication": "pnpm eval bullet-tailor --set adversarial",
    "check:roundtrip": "pnpm script scripts/ops/docx-roundtrip.ts",
    "check:drill": "pnpm script scripts/catalog/drill-bank.ts",
    "render:samples": "pnpm script scripts/ops/render-samples.ts",
    "check:links": "pnpm script scripts/catalog/link-check.ts",
    "check:corpus": "pnpm script scripts/catalog/corpus-health.ts",
    "tokens:calibrate": "pnpm script scripts/ops/tokens-calibrate.ts",
    "seo:indexnow": "pnpm script scripts/ops/indexnow.ts",
    "eval": "pnpm script scripts/evals/run.ts",
    "check:catalog": "pnpm script scripts/catalog/catalog-check.ts",
    "topups:convert": "pnpm script scripts/db/convert-token-topups.ts",
    "move": "pnpm script scripts/tools/move-modules.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.20",
    "@clerk/backend": "^3.14.0",
    "@clerk/nextjs": "^7.6.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/supabase-js": "^2.110.8",
    "ai": "^7.0.37",
    "archiver": "^8.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "fflate": "^0.8.2",
    "file-type": "^22.0.1",
    "lucide-react": "^1.27.0",
    "mammoth": "^1.12.0",
    "nanoid": "^6.0.0",
    "next": "15.5.22",
    "pg": "^8.22.0",
    "postgres": "^3.4.9",
    "quickjs-emscripten": "0.31.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1",
    "svix": "^1.99.1",
    "tailwind-merge": "^3.6.0",
    "unpdf": "^1.8.0",
    "web-push": "^3.6.7",
    "word-extractor": "^1.0.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^8.0.0",
    "@types/node": "^22",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
