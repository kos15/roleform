// Prisma schema — specs.md §6.2.
//
// With no test suite (CLAUDE.md §11) these constraints ARE the safety net.
// Prefer NOT NULL / enum / FK over anything a caller has to remember.
//
// Two constraints carry the product's promise:
//   N1 — TailoredBullet.sourceBulletId required, onDelete: Restrict
//   N2 — InterviewQuestion CHECK (type = 'gap' OR evidence is non-empty)
//        Prisma has no native CHECK attribute; both CHECK constraints are
//        added by hand to the generated migration SQL — see
//        prisma/migrations/*_init/migration.sql and CLAUDE.md §13.
//
//        Both were written with `array_length(x, 1) > 0`, which is NULL on an
//        empty array, so both passed every row until
//        20260810010000_repair_fabrication_checks. A hand-written CHECK is
//        only a guarantee once something has watched it reject.
//
// Model and column names are @@map / @map'd to match the snake_case table and
// column names lib/db/policies.sql already references, so RLS policies never
// need to change when the ORM does.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// Prisma 7 removed connection URLs from schema.prisma entirely (P1012 if set
// here). The CLI (migrate/introspect) reads DIRECT_URL from prisma.config.ts;
// the app runtime connects via the @prisma/adapter-pg driver adapter in
// lib/db/index.ts, pointed at the pooled DATABASE_URL.
datasource db {
  provider = "postgresql"
}

/**
 * ------------------------------------------------------------------ enums
 */

enum ExtractionStatus {
  pending
  ok
  no_text_layer
  encrypted
  failed

  @@map("extraction_status")
}

enum AnalysisStatus {
  parsing
  ready
  failed

  @@map("analysis_status")
}

enum JdSource {
  paste
  upload

  @@map("jd_source")
}

enum BulletScope {
  work
  project
  volunteer
  education

  @@map("bullet_scope")
}

enum RequirementKind {
  hard_skill
  soft_skill
  experience
  education
  certification
  responsibility

  @@map("requirement_kind")
}

enum Necessity {
  required
  preferred
  implied

  @@map("necessity")
}

enum CoverageStatus {
  evidenced
  partial
  absent

  @@map("coverage_status")
}

/// Eight families since v2.7. The five added then are not recolours — each is a
/// different construction with its own honest ATS rating and its own reason.
enum TemplateKind {
  classic
  sidebar
  creative
  banner
  timeline
  modular
  editorial
  infographic

  @@map("template_kind")
}

enum AtsRating {
  High
  Medium
  Low

  @@map("ats_rating")
}

enum TransformKind {
  verbatim
  rephrase
  requantify
  omit

  @@map("transform_kind")
}

/// `system_design` is its own type, not a flavour of `technical`: the Prep tab
/// gives each its own surface, and a filter over a value that doesn't exist in
/// the data is a filter that silently lies.
enum QuestionType {
  behavioral
  technical
  situational
  gap
  culture
  system_design

  @@map("question_type")
}

enum UserLevel {
  none
  exposure
  working
  strong

  @@map("user_level")
}

enum RequiredLevel {
  exposure
  working
  strong
  expert

  @@map("required_level")
}

enum CourseLevel {
  beginner
  intermediate
  advanced

  @@map("course_level")
}

/**
 * ---------------------------------------------- learning engine (RLE spec)
 */

/// How fast material on a skill goes stale (RLE spec §7).
///
/// Drives the recency floor, which is a HARD drop rather than a penalty: a
/// brilliant 2019 Kubernetes talk teaches a Kubernetes that no longer exists,
/// and quality score is not allowed to argue with that.
enum SkillVolatility {
  low
  medium
  high

  @@map("skill_volatility")
}

/// What a catalogued resource IS. Drives format fit in the selector (§7) and
/// the shape of its entry point (§8): a video gets a timestamp, a doc gets a
/// page, a repo gets a file path and the SHA it was verified at.
enum ResourceType {
  course
  video
  doc
  repo
  roadmap

  @@map("resource_type")
}

/// Corpus health, per resource (guardrails.md OUT-7 and "Corpus guardrails").
///
/// `quarantined` exists so a failed ingest is recorded rather than silently
/// dropped — silent drops make corpus coverage unknowable.
enum ResourceStatus {
  active
  stale
  dead
  quarantined

  @@map("resource_status")
}

/// Depth a resource teaches a skill to, and the depth a posting asks for
/// (RLE spec §3). Deliberately three values, not five: the bundle key is
/// (skill, level), and every extra value multiplies the precompute.
enum SkillLevel {
  intro
  working
  deep

  @@map("skill_level")
}

/// The §6 evidence bucket, stored so the narrative and the meter cannot
/// disagree. The synthesiser receives this label — never the freedom to pick
/// one (guardrails.md OUT-5).
enum EvidenceBucket {
  strong
  partial
  none

  @@map("evidence_bucket")
}

enum ExportFormat {
  pdf
  docx
  zip

  @@map("export_format")
}

enum PlanTier {
  free
  pro
  ultra

  @@map("plan")
}

/// Who can change other people's generation caps. Deliberately two values and
/// not a permission bitfield: there is exactly one privileged action in this
/// product, and a role enum makes "who can do it" a column you can read.
enum UserRole {
  member
  admin

  @@map("user_role")
}

/// Where a top-up came from (F19). Two values because they answer different
/// questions in the admin panel: a purchase is revenue, a grant is a decision
/// somebody made and should be able to point at.
enum TokenGrantSource {
  purchase
  admin

  @@map("token_grant_source")
}

/// Where one outbound mail got to (F16). Four states because "we never tried"
/// and "we tried and it bounced" are different facts to an admin reading the
/// inbox: `disabled` means this deployment has no mail keys, so the row is the
/// only record there was ever going to be.
enum MailDelivery {
  pending
  sent
  failed
  disabled

  @@map("mail_delivery")
}

/**
 * ------------------------------------------------------------------ users
 */

/// clerkUserId is TEXT, not uuid — Clerk subjects are strings (§5.3).
model User {
  clerkUserId    String    @id @map("clerk_user_id")
  emailHash      String    @map("email_hash") // N7: never the address itself
  plan           PlanTier  @default(free)
  quotaRemaining Int       @default(10) @map("quota_remaining")
  quotaResetsAt  DateTime? @map("quota_resets_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  role      UserRole @default(member)
  /// Suspended stops NEW generation only. Existing analyses stay readable —
  /// we never lock someone out of their own documents (specs §13).
  suspended Boolean  @default(false)

  /// Generation caps, one per expensive thing the product does (F15).
  /// Separate columns rather than a JSON blob: each is enforced at a different
  /// seam, each needs its own CHECK, and a cap you can't constrain in the
  /// database is a cap the light-testing policy can't rely on (CLAUDE.md §11).
  /// 0 means off, and "off" is a legitimate setting — hence the >= 0 CHECKs
  /// added by hand in the migration rather than a nullable column.
  capAnalyses Int @default(40) @map("cap_analyses") // per cycle
  capResumes  Int @default(11) @map("cap_resumes") // per analysis, of eleven templates
  capAnswers  Int @default(40) @map("cap_answers") // per cycle
  capCourses  Int @default(4) @map("cap_courses") // per gap

  /// The token allowance for one cycle (F19). The meter the other four caps
  /// cannot be: an analysis of a 400-word posting and one of a six-page
  /// posting are both "1" to capAnalyses, and they are not the same work.
  ///
  /// There is deliberately no `tokens_used` column beside it. Usage is SUMmed
  /// from `ai_runs`, which already records the real input and output tokens of
  /// every call — so a run that dies half-way costs exactly what it burned,
  /// and no crash between two writes can drift a balance that isn't stored.
  capTokens Int @default(60000) @map("cap_tokens") // per cycle

  tokenGrants TokenGrant[]

  @@map("users")
}

/// A one-off top-up: tokens bought or granted, outside the cycle allowance.
///
/// A row per grant rather than a running total on `users`, for the same reason
/// usage is SUMmed from `ai_runs` rather than decremented: a stored balance is
/// a number two writes can disagree about, and this one is written by a public
/// webhook the provider will redeliver on any non-2xx.
///
/// `reference` is what makes that safe — the payment id for a purchase, so the
/// UNIQUE index turns a redelivered webhook into a conflict instead of a second
/// credit. Idempotency as a constraint, not as a remembered check (§11).
///
/// Top-ups never expire. That is the only thing distinguishing them from a cap:
/// unspent tokens survive the cycle turnover, which is what /pricing promises.
model TokenGrant {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkUserId String           @map("clerk_user_id")
  tokens      Int
  source      TokenGrantSource
  /// Payment id, or `admin:<uuid>` for a hand grant. Unique, always.
  reference   String           @unique
  /// The admin who granted it. Null on a purchase — nobody granted that.
  grantedBy   String?          @map("granted_by")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [clerkUserId], references: [clerkUserId], onDelete: Cascade)

  @@index([clerkUserId], map: "token_grants_user_idx")
  @@map("token_grants")
}

/// The caps a NEW account is created with (F15).
///
/// One row, always. The column defaults on `users` are what Postgres applies
/// when nothing else says otherwise; this is what the workspace says instead,
/// and `provisionUser` reads it at account creation. Changing a default never
/// touches an existing member — their caps are already their own row, and
/// silently re-capping people who have been working under a number is the
/// opposite of the promise the panel makes.
///
/// Same bounds as the per-member caps, CHECKed by hand in the migration for
/// the same reason (CLAUDE.md §11): with no test suite the constraint is the
/// guarantee.
model WorkspaceSettings {
  /// Fixed key. A single-row table with a real primary key beats a bare
  /// `settings` row we have to remember not to duplicate.
  id String @id @default("workspace")

  capTokens   Int @default(60000) @map("cap_tokens")
  capAnalyses Int @default(40) @map("cap_analyses")
  capResumes  Int @default(11) @map("cap_resumes")
  capAnswers  Int @default(40) @map("cap_answers")
  capCourses  Int @default(4) @map("cap_courses")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("workspace_settings")
}

/// Support mail (F16). Not user-owned content in the résumé sense, but it
/// carries an address the sender typed on purpose, so it lives behind RLS with
/// the same shape as everything else and is never joined to a profile.
model ContactMessage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkUserId String?  @map("clerk_user_id")
  name        String
  email       String
  subject     String
  body        String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  /// The mail to us. The row is written first and this is written after, so a
  /// send that fails loses nothing — the message is already filed and the
  /// inbox shows it as undelivered rather than pretending it arrived.
  notification  MailDelivery @default(pending)
  /// The receipt to the sender. Tracked separately because the two fail for
  /// different reasons: ours is a provider problem, theirs is usually a typo
  /// in the address, and only one of those is worth chasing.
  receipt       MailDelivery @default(pending)
  notifiedAt    DateTime?    @map("notified_at") @db.Timestamptz
  /// The provider's own words, truncated. Never logged (N7) — it names the
  /// recipient, and this row is the only place that address belongs.
  deliveryError String?      @map("delivery_error")

  /// Answered, by whom. Both or neither — CHECKed in the migration, because a
  /// handled flag with nobody's name on it is a queue nobody owns.
  handledAt DateTime? @map("handled_at") @db.Timestamptz
  handledBy String?   @map("handled_by")

  @@index([createdAt], map: "contact_messages_created_idx")
  @@index([handledAt], map: "contact_messages_handled_idx")
  @@map("contact_messages")
}

/**
 * -------------------------------------------------------- source documents
 */

model SourceDocument {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkUserId      String           @map("clerk_user_id")
  storagePath      String           @map("storage_path")
  bucket           String
  mime             String
  filename         String
  sizeBytes        Int              @map("size_bytes")
  extractionStatus ExtractionStatus @default(pending) @map("extraction_status")
  extractedText    String?          @map("extracted_text")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz

  masterProfiles MasterProfile[]

  @@index([clerkUserId], map: "source_documents_user_idx")
  @@map("source_documents")
}

/**
 * --------------------------------------------------------- master profiles
 */

model MasterProfile {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkUserId      String   @map("clerk_user_id")
  resumeJson       Json     @map("resume_json")
  schemaVersion    Int      @default(1) @map("schema_version")
  sourceDocumentId String?  @map("source_document_id") @db.Uuid
  yearsExperience  Decimal  @default("0") @map("years_experience") @db.Decimal(4, 1)
  skillCount       Int      @default(0) @map("skill_count")
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz

  sourceDocument    SourceDocument?    @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  experienceBullets ExperienceBullet[]
  analyses          Analysis[]

  @@index([clerkUserId], map: "master_profiles_user_idx")
  @@map("master_profiles")
}

/**
 * ------------------------------------------------------- experience bullets
 */

/// The evidence table. Written only by user action / reviewed import (N3).
model ExperienceBullet {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkUserId   String      @map("clerk_user_id")
  profileId     String      @map("profile_id") @db.Uuid
  scope         BulletScope
  scopeRef      String      @map("scope_ref") // 'work.1' — points into resume_json
  ordinal       Int
  text          String // verbatim, as the user wrote it
  skillIds      String[]    @default([]) @map("skill_ids") @db.Uuid
  metrics       Json        @default("[]")
  recencyMonths Int?        @map("recency_months")
  /// Removed from the profile, kept for provenance.
  ///
  /// A tailored bullet points here with onDelete: Restrict (N1), so a bullet a
  /// past analysis cited cannot be deleted without taking that analysis's
  /// evidence with it — and §6.2 invariant 4 says profile edits never rewrite
  /// history. Retiring is how both stay true: the row survives so old drafts
  /// keep their source, and every read of the living profile filters it out.
  retiredAt     DateTime?   @map("retired_at") @db.Timestamptz

  profile         MasterProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tailoredBullets TailoredBullet[]
  /// Plans that stage a rewrite of this bullet (RLE §1). Restrict, like N1.
  stagedGaps      SkillGap[]
  learningSteps   LearningStep[]

  @@index([profileId], map: "experience_bullets_profile_idx")
  @@index([clerkUserId], map: "experience_bullets_user_idx")
  @@map("experience_bullets")
}

/**
 * --------------------------------------------------------------- analyses
 */

model Analysis {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkUserId    String         @map("clerk_user_id")
  profileId      String         @map("profile_id") @db.Uuid
  jdSource       JdSource       @map("jd_source")
  jdFilename     String?        @map("jd_filename")
  rawText        String         @map("raw_text")
  contentHash    String         @map("content_hash")
  company        String?
  title          String?
  location       String?
  seniority      String?
  employmentType String?        @map("employment_type")
  score          Decimal?       @db.Decimal(5, 2)
  scoreVerdict   String?        @map("score_verdict")
  scoreNote      String?        @map("score_note")
  status         AnalysisStatus @default(parsing)
  stageState     Json           @default("{}") @map("stage_state")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz

  /// Filed against a token wall, waiting for the cycle to turn over (F19).
  ///
  /// The posting is already stored on this row — that is the whole point: the
  /// member does not have to find it again. A queued run is an ordinary
  /// `parsing` analysis that nothing has started yet, so the resume path is
  /// the one lib/status/stalled.ts already walks, and there is no worker, no
  /// cron and no second execution path to keep honest (CLAUDE.md §8).
  ///
  /// Cleared when the run finally starts. Null on every analysis that was
  /// never blocked, which is almost all of them.
  queuedAt DateTime? @map("queued_at") @db.Timestamptz

  profile            MasterProfile       @relation(fields: [profileId], references: [id], onDelete: Restrict)
  jdRequirements     JdRequirement[]
  coverageItems      CoverageItem[]
  resumeDrafts       ResumeDraft[]
  interviewQuestions InterviewQuestion[]
  skillGaps          SkillGap[]
  learningPlan       LearningPlan?
  exports            Export[]

  // F2: identical JD text reuses the prior analysis — no second charge.
  @@unique([clerkUserId, contentHash], map: "analyses_user_content_hash")
  @@index([clerkUserId, createdAt], map: "analyses_user_created_idx")
  @@map("analyses")
}

/**
 * -------------------------------------------------------- jd requirements
 */

model JdRequirement {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkUserId   String          @map("clerk_user_id")
  analysisId    String          @map("analysis_id") @db.Uuid
  kind          RequirementKind
  text          String
  necessity     Necessity
  mentionCount  Int             @default(1) @map("mention_count") // drives Learning order
  skillId       String?         @map("skill_id") @db.Uuid
  evidenceQuote String          @map("evidence_quote") // the JD span this came from

  analysis           Analysis            @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  skill              Skill?              @relation(fields: [skillId], references: [id], onDelete: SetNull)
  coverageItems      CoverageItem[]
  tailoredBullets    TailoredBullet[]
  interviewQuestions InterviewQuestion[]
  skillGaps          SkillGap[]

  @@index([analysisId], map: "jd_requirements_analysis_idx")
  @@map("jd_requirements")
}

/**
 * --------------------------------------------------------- coverage items
 */

model CoverageItem {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkUserId       String         @map("clerk_user_id")
  analysisId        String         @map("analysis_id") @db.Uuid
  requirementId     String         @map("requirement_id") @db.Uuid
  status            CoverageStatus
  evidenceBulletIds String[]       @default([]) @map("evidence_bullet_ids") @db.Uuid
  rationale         String

  analysis    Analysis      @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  requirement JdRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  // CHECK (status <> 'evidenced' OR cardinality(evidence_bullet_ids) > 0)
  // added by hand in the migration SQL — see the header comment.
  //
  // `cardinality`, NOT `array_length(x, 1)`: array_length returns NULL for an
  // empty array, so the original guard evaluated to NULL and a CHECK only
  // rejects on FALSE. It was inert from M1 until the repair migration.

  @@index([analysisId], map: "coverage_items_analysis_idx")
  @@map("coverage_items")
}

/**
 * --------------------------------------------------------------- templates
 */

/// Seeded reference data. Public read, no RLS.
model Template {
  id              String       @id
  name            String
  kind            TemplateKind
  blurb           String
  accent          String
  structuralFlags Json         @map("structural_flags")

  resumeDrafts ResumeDraft[]

  @@map("templates")
}

/**
 * ----------------------------------------------------------- resume drafts
 */

model ResumeDraft {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkUserId String    @map("clerk_user_id")
  analysisId  String    @map("analysis_id") @db.Uuid
  templateId  String    @map("template_id")
  resumeJson  Json      @map("resume_json")
  atsRating   AtsRating @map("ats_rating") // computed (N5), never hand-assigned
  pageCount   Int       @default(1) @map("page_count")
  changes     String[]  @default([])
  missing     String[]  @default([])
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  analysis        Analysis         @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  template        Template         @relation(fields: [templateId], references: [id], onDelete: Restrict)
  tailoredBullets TailoredBullet[]
  exports         Export[]

  @@unique([analysisId, templateId], map: "resume_drafts_analysis_template")
  @@index([analysisId], map: "resume_drafts_analysis_idx")
  @@map("resume_drafts")
}

/**
 * --------------------------------------------------- tailored bullets (N1)
 */

model TailoredBullet {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkUserId          String        @map("clerk_user_id")
  draftId              String        @map("draft_id") @db.Uuid
  // ★ FABRICATION GUARD #1 — a bullet without provenance cannot exist.
  sourceBulletId       String        @map("source_bullet_id") @db.Uuid
  originalText         String        @map("original_text") // snapshot: profile edits never rewrite history
  rewrittenText        String        @map("rewritten_text")
  transform            TransformKind
  targetsRequirementId String?       @map("targets_requirement_id") @db.Uuid
  aiRunId              String?       @map("ai_run_id") @db.Uuid
  ordinal              Int           @default(0)

  draft              ResumeDraft      @relation(fields: [draftId], references: [id], onDelete: Cascade)
  sourceBullet       ExperienceBullet @relation(fields: [sourceBulletId], references: [id], onDelete: Restrict)
  targetsRequirement JdRequirement?   @relation(fields: [targetsRequirementId], references: [id], onDelete: SetNull)
  aiRun              AiRun?           @relation(fields: [aiRunId], references: [id], onDelete: SetNull)

  @@index([draftId], map: "tailored_bullets_draft_idx")
  @@map("tailored_bullets")
}

/**
 * ----------------------------------------------- interview questions (N2)
 */

model InterviewQuestion {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkUserId         String       @map("clerk_user_id")
  analysisId          String       @map("analysis_id") @db.Uuid
  ordinal             Int
  type                QuestionType
  text                String
  likely              Boolean      @default(false)
  whyTheyAsk          String       @map("why_they_ask")
  frame               String[]
  evidenceBulletIds   String[]     @default([]) @map("evidence_bullet_ids") @db.Uuid
  sourceRequirementId String?      @map("source_requirement_id") @db.Uuid

  analysis          Analysis        @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  sourceRequirement JdRequirement?  @relation(fields: [sourceRequirementId], references: [id], onDelete: SetNull)
  answer            QuestionAnswer?
  /// Gaps whose material makes this question answerable (RLE §1).
  boundGaps         SkillGap[]
  learningSteps     LearningStep[]
  // ★ FABRICATION GUARD #2 — CHECK (type = 'gap' OR cardinality(evidence_bullet_ids) > 0)
  // added by hand in the migration SQL — see the header comment. `cardinality`
  // rather than `array_length(x, 1)` for the reason spelled out on
  // CoverageItem: the latter is NULL on an empty array, and a NULL CHECK
  // passes. This guard did nothing at all until the repair migration.

  @@index([analysisId], map: "interview_questions_analysis_idx")
  @@map("interview_questions")
}

/**
 * ------------------------------------------------- worked answers (F7.2)
 */

/// A full worked answer for one question, drafted on demand by the mid tier.
///
/// Deliberately separate from InterviewQuestion: it is generated lazily, per
/// question, only when the user asks for it. Folding it into the analysis
/// pipeline would put twelve extra model calls on the critical path of every
/// run for a surface most users open once.
///
/// The fabrication boundary still holds (CLAUDE.md §3). `resumeHooks` are the
/// only place the answer speaks in the first person, and every one of them
/// carries the `experience_bullet` it derives from — same shape as N1, one FK
/// short of it because the ids live inside the JSON payload the Zod schema
/// validates on the way in AND on the way out. `theory` is general technical
/// knowledge about the domain, not a claim about the candidate.
model QuestionAnswer {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkUserId String   @map("clerk_user_id")
  questionId  String   @unique @map("question_id") @db.Uuid
  analysisId  String   @map("analysis_id") @db.Uuid
  headline    String
  /// [{ heading, body }] — the worked answer, validated by AnswerSectionSchema.
  sections    Json     @default("[]")
  /// [{ bulletId, useIt }] — first-person material, each tied to one bullet.
  resumeHooks Json     @default("[]") @map("resume_hooks")
  followUps   String[] @default([]) @map("follow_ups")
  keyConcepts String[] @default([]) @map("key_concepts")
  aiRunId     String?  @map("ai_run_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  question InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  aiRun    AiRun?            @relation(fields: [aiRunId], references: [id], onDelete: SetNull)

  @@index([analysisId], map: "question_answers_analysis_idx")
  @@map("question_answers")
}

/**
 * ------------------------------------------------------------------ skills
 */

/// Canonical vocabulary, and the taxonomy spine of the learning engine.
/// Public read.
///
/// RLE spec §0: "the roadmap.sh skill taxonomy is the join key that makes
/// precomputation possible." `parentId` / `depth` / `roadmapPath` are what turn
/// this from a flat alias table into that join key — they let the engine walk
/// two hops to grade adjacent evidence (§6), weight leaf nodes above roots (§5),
/// and fall back to a roadmap link when the corpus has nothing (§9).
///
/// `roadmapPath` is INGESTED, never fetched at request time. A third-party call
/// in the request path adds latency, a failure mode and a rate limit to every
/// run, for data that changes monthly at most (§4).
model Skill {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String          @unique
  category    String
  aliases     String[]        @default([])
  /// URL-safe, stable, derived from `name`. The public identifier for a node.
  slug        String?         @unique
  /// roadmap.sh slug this node is documented at, e.g. 'react'. Null where
  /// roadmap.sh has no honest home for the topic — we would rather show no
  /// fallback than a link that lands on something unrelated.
  roadmapPath String?         @map("roadmap_path")
  parentId    String?         @map("parent_id") @db.Uuid
  /// 0 for a root. Derived from the parent chain by the seed script, never set
  /// by hand — a hand-set depth that disagrees with `parentId` would silently
  /// skew every importance score computed from it.
  depth       Int             @default(0)
  volatility  SkillVolatility @default(medium)

  parent   Skill?  @relation("SkillTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Skill[] @relation("SkillTree")

  jdRequirements JdRequirement[]
  skillGaps      SkillGap[]
  courseSkills   CourseSkill[]
  bundles        SkillBundle[]
  corpusGaps     CorpusGap[]

  @@index([name], map: "skills_name_idx")
  @@index([parentId], map: "skills_parent_idx")
  @@map("skills")
}

/**
 * ------------------------------------------------------------ corpus growth
 */

/// A term a real posting used that the resolver could not place (RLE spec §4,
/// tier 4). Public-facing consequence: it is excluded from gap analysis, so the
/// failure mode is a gap we don't mention, never a gap we invent.
///
/// This table is the taxonomy's growth mechanism. Ranked by `seenCount` it says
/// exactly which alias or node to add next, derived from the market rather than
/// from a curator guessing. Carries no user id and no analysis id: the term is
/// public content, the pairing with a person is not.
model UnresolvedTerm {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Normalised form — the deduplication key.
  normalised  String   @unique
  /// Surface form as the posting wrote it. Kept because an unresolved term is
  /// only useful for corpus growth if we kept its wording.
  term        String
  seenCount   Int      @default(1) @map("seen_count")
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz

  @@index([seenCount(sort: Desc)], map: "unresolved_terms_demand_idx")
  @@map("unresolved_terms")
}

/// A (skill, level) pair a real run needed and the corpus could not serve
/// (RLE spec §9). Ranked by `count` this table IS the ingestion backlog.
///
/// The fallback path is a product feature, not a degradation: it tells us what
/// to index next, ranked by demand we actually observed.
model CorpusGap {
  skillId    String     @map("skill_id") @db.Uuid
  level      SkillLevel
  count      Int        @default(1)
  lastSeenAt DateTime   @default(now()) @map("last_seen_at") @db.Timestamptz

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([skillId, level])
  @@index([count(sort: Desc)], map: "corpus_gaps_demand_idx")
  @@map("corpus_gaps")
}

/**
 * -------------------------------------------------------------- skill gaps
 */

/// One ranked gap. The unit the Learning tab renders and the plan is built from.
///
/// The RLE fields below were added onto this model rather than into a parallel
/// `LearningGap`, because two tables both meaning "a thing this posting wants
/// that your profile can't evidence" is exactly the synonym CLAUDE.md §13
/// forbids — and every existing reader (admin counts, profile strength) would
/// then be counting the wrong one.
///
/// `severity`, `importance` and `evidenceCredit` are stored, not recomputed on
/// read: they are the output of a pure function over inputs that can change
/// underneath them (the profile is editable), and a gap list that silently
/// re-ranks when the user edits an unrelated bullet would make the plan they
/// printed last week disagree with the plan on screen.
model SkillGap {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkUserId   String        @map("clerk_user_id")
  analysisId    String        @map("analysis_id") @db.Uuid
  skillId       String        @map("skill_id") @db.Uuid
  userLevel     UserLevel     @map("user_level")
  requiredLevel RequiredLevel @map("required_level")
  mentionCount  Int           @default(1) @map("mention_count")
  note          String

  /**
   * -------------------------------------------------- RLE spec §5/§6/§1
   */

  /// Rank in the plan. 0 is the gap most worth closing.
  ordinal        Int            @default(0)
  /// importance × (1 − evidence) × 100. Deterministic (lib/domain/severity.ts).
  severity       Decimal        @default(0) @db.Decimal(5, 2)
  /// w_section × w_modality × w_repetition × w_position × w_depth, clamped 0–1.
  importance     Decimal        @default(0) @db.Decimal(4, 3)
  /// The §6 credit, 0–1. Stored beside its bucket so the meter and the prose
  /// are generated from the same number and cannot disagree (OUT-5).
  evidenceCredit Decimal        @default(0) @map("evidence_credit") @db.Decimal(4, 3)
  evidenceBucket EvidenceBucket @default(none) @map("evidence_bucket")
  /// The depth the posting asks this skill to, in bundle terms.
  targetLevel    SkillLevel     @default(working) @map("target_level")

  /// The requirement this gap came from. Nullable only because a gap can
  /// outlive a re-analysis; on write it is always set.
  requirementId String? @map("requirement_id") @db.Uuid
  /// The verbatim JD span `whyItMatters` is grounded in (OUT-4). Empty string
  /// when the run degraded before synthesis.
  jdQuote       String  @default("") @map("jd_quote")
  /// One sentence from S6 connecting the skill to the day-to-day of the role.
  whyItMatters  String  @default("") @map("why_it_matters")

  /**
   * --------------------------------- the proof-of-learning loop (§1)
   */

  /// The bullet that becomes truthfully rewritable once this gap is closed.
  ///
  /// onDelete: Restrict, exactly as N1 does for TailoredBullet: a bullet a plan
  /// cites cannot be deleted without taking the plan's provenance with it. The
  /// profile editor retires bullets rather than deleting them, so this restricts
  /// nothing a user can actually do.
  unlocksBulletId    String? @map("unlocks_bullet_id") @db.Uuid
  /// The prospective rewrite. Never a claim the candidate can make today —
  /// checked by guardrails.md OUT-2 before it is written (lib/domain/guardrails).
  unlocksBulletDraft String? @map("unlocks_bullet_draft")
  /// The interview question this gap's material lets them answer.
  answersQuestionId  String? @map("answers_question_id") @db.Uuid

  /**
   * ------------------------------------------------ §9 corpus fallback
   */

  /// Set only when the bundle was empty. Mutually exclusive with having steps:
  /// a gap either has vetted material or it has the roadmap, never both.
  fallbackUrl   String? @map("fallback_url")
  fallbackLabel String? @map("fallback_label")

  analysis        Analysis           @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  skill           Skill              @relation(fields: [skillId], references: [id], onDelete: Restrict)
  requirement     JdRequirement?     @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  unlocksBullet   ExperienceBullet?  @relation(fields: [unlocksBulletId], references: [id], onDelete: Restrict)
  answersQuestion InterviewQuestion? @relation(fields: [answersQuestionId], references: [id], onDelete: SetNull)
  steps           LearningStep[]

  @@index([analysisId], map: "skill_gaps_analysis_idx")
  @@index([unlocksBulletId], map: "skill_gaps_unlocks_bullet_idx")
  @@map("skill_gaps")
}

/**
 * --------------------------------------------------------- learning plans
 */

/// The run-level narrative and the budget it was solved against (RLE spec §10).
///
/// One row per analysis. It is the container for the SOLVED sequence, which is
/// deterministic (lib/domain/plan.ts) — not for the model's output, which only
/// fills `opening` and `sequenceNote`.
///
/// That split is what makes agent.md §7's degradation ladder work. When S6
/// fails, the row is still written with both narrative fields empty: the user
/// gets "gaps and resources, no narrative", which is level 2 and still
/// genuinely useful, rather than losing a plan the knapsack had already solved.
model LearningPlan {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkUserId    String   @map("clerk_user_id")
  analysisId     String   @unique @map("analysis_id") @db.Uuid
  /// Two sentences: what already matches, then what the gaps are.
  opening        String
  /// Why the order is what it is. The order itself was solved, not written.
  sequenceNote   String   @map("sequence_note")
  /// The budget the knapsack was solved against, in minutes. Null when the
  /// user set none and the plan is simply everything, in order.
  budgetMin      Int?     @map("budget_min")
  /// Total duration of the sequenced steps. Stored so the header can't drift
  /// from the sum of what is rendered beneath it.
  totalMin       Int      @default(0) @map("total_min")
  /// How many gaps fell through to a roadmap link. The §9 metric, per run.
  fallbackCount  Int      @default(0) @map("fallback_count")
  /// Fraction of extracted terms the resolver placed. Below 0.90 the taxonomy
  /// is drifting behind the market (§4) — recorded per run so the trend is
  /// readable without re-running anything.
  resolutionRate Decimal  @default(1) @map("resolution_rate") @db.Decimal(4, 3)
  aiRunId        String?  @map("ai_run_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  analysis Analysis       @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  aiRun    AiRun?         @relation(fields: [aiRunId], references: [id], onDelete: SetNull)
  steps    LearningStep[]

  @@map("learning_plans")
}

/// One resource, bound to one gap, at one position in the sequence.
///
/// ── The precision bar, and where it actually lives ──────────────────────────
/// RLE spec §1 says "a resource that cannot be bound to all three is not shown"
/// — the gap it closes, the résumé bullet it unlocks, the interview question it
/// answers. That was first built as two NOT NULL columns here.
///
/// Measured against a real profile, it withheld vetted material for 5 of 6 gaps.
/// The corpus had good Kubernetes and GraphQL resources; the bar hid them
/// because no bullet and no question happened to bind. That is a bad trade, and
/// the reason is worth stating precisely: **the risk the bar was built to stop
/// is a FALSE binding, not an absent one.** A card that says "here are two
/// vetted Kubernetes resources" and claims nothing about the candidate's résumé
/// makes no false claim at all. A card that claims the wrong bullet does.
///
/// So the bindings are nullable, and the guarantee moved to where the risk is:
///
///   · they are set ONLY by the deterministic binder (lib/domain/binding.ts),
///     which returns null rather than something arbitrary — never by a model;
///   · when present they are real foreign keys, which is what makes them
///     checkable at all;
///   · `SkillGap.unlocks_bullet_draft` carries a CHECK that it cannot exist
///     without `unlocks_bullet_id`. THAT is the fabrication guard that matters:
///     a staged rewrite with no source bullet is exactly the state guardrails.md
///     OUT-2 forbids, and it is now unrepresentable.
model LearningStep {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkUserId String @map("clerk_user_id")
  planId      String @map("plan_id") @db.Uuid
  gapId       String @map("gap_id") @db.Uuid
  courseId    String @map("course_id") @db.Uuid

  /// Position in the solved sequence, 0-based. Prerequisites come first.
  ordinal     Int
  /// Minutes elapsed in the plan before this step starts. Solved, not narrated.
  startsAtMin Int @map("starts_at_min")
  durationMin Int @map("duration_min")

  /// The precise entry point, copied from CourseSkill at plan time so the plan
  /// still reads correctly after a bundle rebuild moves it (§8).
  entryLabel String? @map("entry_label")
  entryUrl   String? @map("entry_url")
  /// One sentence from S6 on why this entry point, given what they already
  /// know. Built from the precomputed summary — S6 never saw chunk text (I2).
  note       String  @default("")

  /// Null when the binder found nothing honest to point at. Never a guess.
  unlocksBulletId   String? @map("unlocks_bullet_id") @db.Uuid
  answersQuestionId String? @map("answers_question_id") @db.Uuid

  plan            LearningPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  gap             SkillGap           @relation(fields: [gapId], references: [id], onDelete: Cascade)
  course          Course             @relation(fields: [courseId], references: [id], onDelete: Restrict)
  unlocksBullet   ExperienceBullet?  @relation(fields: [unlocksBulletId], references: [id], onDelete: Restrict)
  answersQuestion InterviewQuestion? @relation(fields: [answersQuestionId], references: [id], onDelete: Cascade)

  @@index([planId, ordinal], map: "learning_steps_plan_idx")
  @@index([gapId], map: "learning_steps_gap_idx")
  @@map("learning_steps")
}

/**
 * ----------------------------------------------------------------- courses
 */

/// CURATED catalog (N8). Public read. Never model-generated.
///
/// This is also the learning engine's `resources` table. It is not a second
/// one: CLAUDE.md §13 fixes `Course` as the vocabulary for "a vetted thing we
/// can send someone to", and introducing `Resource` alongside it would be the
/// synonym that rule exists to prevent. The RLE columns below are what the spec
/// calls a resource row — type, author, quality, liveness — sitting on it.
model Course {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider      String
  title         String
  url           String      @unique
  priceLabel    String      @map("price_label")
  lengthLabel   String      @map("length_label")
  level         CourseLevel
  mark          String
  /// Denormalised skill ids, kept for the deterministic course matcher that
  /// predates the engine (lib/catalog/match.ts). `CourseSkill` is the richer
  /// join the engine reads — this stays because two readers want two shapes.
  skillIds      String[]    @default([]) @map("skill_ids") @db.Uuid
  isFree        Boolean     @map("is_free")
  lengthMinutes Int         @map("length_minutes")
  verifiedAt    DateTime    @map("verified_at") @db.Date

  /**
   * --------------------------------------------------- RLE spec §3, §7
   */

  type          ResourceType   @default(course)
  /// Creator or channel. Drives the diversity rule — max two per author in one
  /// bundle, so a single prolific creator cannot monopolise a skill.
  author        String?
  /// Publication date, where the source carries one. Feeds the recency floor.
  publishedAt   DateTime?      @map("published_at") @db.Date
  /// Computed at ingest from authority, recency and completeness. Never a model
  /// judgement, and never hand-tuned to flatter a favourite (§3).
  qualityScore  Decimal        @default(0.5) @map("quality_score") @db.Decimal(4, 3)
  status        ResourceStatus @default(active)
  /// Free-form tags the stack filter reads: 'typescript', 'python', 'v2'.
  tags          String[]       @default([])
  /// Bumped by the ingest run that last touched this row. Lets a bundle say
  /// which corpus it was built from.
  corpusVersion Int            @default(1) @map("corpus_version")

  courseSkills CourseSkill[]
  steps        LearningStep[]

  @@index([status], map: "courses_status_idx")
  @@map("courses")
}

/// The join, built at ingest — RLE spec §3's `resource_skills`.
///
/// This is where the precision play lives (§8). `entryLabel` / `entryUrl` are
/// the difference between "watch minutes 14:20–26:05 of this" and "watch this
/// eight-hour course", and they are computed once at bundle-build time and
/// stored, never derived at request time.
///
/// `summary` is the mechanism behind invariant I2: it is the ONLY chunk-derived
/// text that ever reaches a user-facing model. Generated once at ingest, so the
/// synthesiser gets meaning without ever receiving the content itself.
model CourseSkill {
  courseId   String     @map("course_id") @db.Uuid
  skillId    String     @map("skill_id") @db.Uuid
  level      SkillLevel
  confidence Decimal    @default(1) @db.Decimal(4, 3)
  isPrimary  Boolean    @default(false) @map("is_primary")
  entryLabel String?    @map("entry_label")
  entryUrl   String?    @map("entry_url")
  summary    String?

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([courseId, skillId])
  @@index([skillId, level, confidence(sort: Desc)], map: "course_skills_lookup_idx")
  @@map("course_skills")
}

/// The precomputed answer cache — the reason request-time retrieval costs
/// nothing (RLE spec §3, §7, rag-strategy.md §7).
///
/// One row per (skill, level). Built by `pnpm bundles:rebuild`, read by every
/// user forever. If a change ever adds a search, an embedding call or a rerank
/// to the request path, it violates invariant I1 and needs a written
/// justification — not a patch.
model SkillBundle {
  skillId         String     @map("skill_id") @db.Uuid
  level           SkillLevel
  /// Top five, diversity-enforced, in rank order.
  rankedCourseIds String[]   @default([]) @map("ranked_course_ids") @db.Uuid
  /// { courseId: { entryLabel, entryUrl, summary } } — frozen at build time.
  entryPoints     Json       @default("{}") @map("entry_points")
  corpusVersion   Int        @default(1) @map("corpus_version")
  refreshedAt     DateTime   @default(now()) @map("refreshed_at") @db.Timestamptz

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([skillId, level])
  @@map("skill_bundles")
}

/**
 * ----------------------------------------------------------------- exports
 */

model Export {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkUserId String       @map("clerk_user_id")
  analysisId  String       @map("analysis_id") @db.Uuid
  draftId     String?      @map("draft_id") @db.Uuid
  format      ExportFormat
  storagePath String       @map("storage_path")
  bytes       Int
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz

  analysis Analysis     @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  draft    ResumeDraft? @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([clerkUserId], map: "exports_user_idx")
  @@map("exports")
}

/**
 * ----------------------------------------------------------------- ai runs
 */

model AiRun {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkUserId   String   @map("clerk_user_id")
  analysisId    String?  @map("analysis_id") @db.Uuid
  purpose       String
  model         String
  promptVersion String   @map("prompt_version")
  inputTokens   Int      @default(0) @map("input_tokens")
  outputTokens  Int      @default(0) @map("output_tokens")
  latencyMs     Int      @default(0) @map("latency_ms")
  schemaValid   Boolean  @map("schema_valid")
  retryCount    Int      @default(0) @map("retry_count")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  tailoredBullets TailoredBullet[]
  questionAnswers QuestionAnswer[]
  learningPlans   LearningPlan[]

  @@index([clerkUserId, createdAt], map: "ai_runs_user_created_idx")
  @@map("ai_runs")
}
