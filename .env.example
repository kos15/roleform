# --- Clerk (auth) ------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Supabase (one project per environment: local / preview / production) -----
# Storage + RLS-scoped reads only. Prisma (below) is the app's DB access path;
# these two are used for Storage buckets and the anon-client RLS smoke test.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# SERVER ONLY. Never expose. Used by webhooks, seeding, admin scripts, storage writes.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Database (Prisma, via the same Supabase Postgres instance) ---------------
# Transaction-mode pooler (pgbouncer, port 6543) — the app's runtime connection.
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
# Session-mode pooler (port 5432) — migrations need a real session, not a
# transaction pool. Prisma requires both when the primary URL is pooled.
DIRECT_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# --- Models ------------------------------------------------------------------
# lib/ai/models.ts is the only file that names a provider — the AI SDK makes
# swapping one a one-import change.
OPENAI_API_KEY=sk-proj-xxx

# --- Job search (F22, F22.1) ---------------------------------------------------
# Six documented job-board APIs, each behind its own adapter
# (lib/jobs/sources/{adzuna,jooble,freehire,greenhouse,lever,ashby}.ts). Only Adzuna
# and Jooble need keys; the other four are public and keyless. Unset is a supported state per source:
# an unkeyed source is simply not queried (JobSource.configured() reads false),
# never attempted and failed. Job search is a Pro-only feature either way
# (capJobSearches is 0 on Free) — these keys matter once a paying member can
# reach the page at all.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# ISO country code Adzuna searches within. Defaults to "in".
ADZUNA_COUNTRY=in
JOOBLE_API_KEY=
# freehire.me's public API needs no key, so it runs unless switched off. Point
# it at a self-hosted instance (github.com/strelov1/freehire) if you run one.
FREEHIRE_API_URL=
# Extra employer boards for the Greenhouse / Lever / Ashby sources (F22.2), on top
# of the curated list in lib/jobs/sources/ats-boards.ts. Format "ats:token", e.g.
# "greenhouse:acme,lever:widgets,ashby:example-co". The token is the slug in the
# company's job-board URL. A token that 404s shows up in the source's health line.
JOBS_ATS_BOARDS=
# Comma-separated source ids to keep installed but skip, e.g. "jooble,freehire,lever"
# (F22.1, R2). A skipped source is reported as switched off, never silently absent.
JOBS_DISABLED_SOURCES=

# --- Delivery ----------------------------------------------------------------
# CloudFront in front of the exports bucket only. The app is NOT proxied.
NEXT_PUBLIC_FILES_BASE_URL=https://files.koustubh.org

# --- Payments (F17) ----------------------------------------------------------
# Razorpay. The secret and the webhook secret are SERVER ONLY and never reach a
# client bundle; key_id is publishable and the checkout widget needs it.
# Unset is a supported state: the Pro button says payments aren't switched on
# rather than failing into a blank window.
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=
# Set this to the same value in the Razorpay dashboard's webhook settings. The
# handler refuses any request whose signature doesn't verify against it.
RAZORPAY_WEBHOOK_SECRET=

# --- Workspace ---------------------------------------------------------------
# Names the admin panel's kicker and the 403's admin list. Leave unset and both
# fall back to their generic wording — we never invent a company name onto
# someone's 403.
NEXT_PUBLIC_WORKSPACE_NAME=

# --- Notifications (F29) -------------------------------------------------------
# Web Push for interview-round reminders. Generate the pair once per
# environment with `pnpm push:keys`. Unset is a supported state: the profile and
# the Rounds tab say notifications aren't switched on, and nothing subscribes.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who push services contact about this sender. A mailto: or https: URL.
VAPID_SUBJECT=mailto:support@koustubh.org
# Bearer token the scheduler sends to /api/cron/reminders. 32+ random chars
# (`openssl rand -hex 32`). Unset refuses every call. After setting it, run
# `APP_URL=https://roleform.koustubh.org pnpm db:schedule` once per
# environment to install the Supabase pg_cron job that calls the route.
CRON_SECRET=

# --- Mail (F16) --------------------------------------------------------------
# Two systems, one domain, and they do not overlap:
#
#   inbound  — Cloudflare Email Routing forwards @koustubh.org to a person.
#              DNS only, nothing here configures it. It CANNOT send: Email
#              Routing has no outbound path, which is why the block below
#              exists at all.
#   outbound — Resend, called over fetch, no SDK (lib/mail/send.ts). Free tier
#              is 3,000 messages a month with no expiry, which support volume
#              never approaches.
#
# Unset is a supported state: the contact form still files every message and the
# admin inbox (/admin?panel=inbox) is the read path. What we never do is tell a
# sender we emailed someone when we didn't.
RESEND_API_KEY=
# MUST be on a domain verified in the Resend dashboard. That domain is
# roleform.koustubh.org, and its DKIM/SPF records sit BELOW the CNAME that
# points the name itself at Vercel — `resend._domainkey.roleform` and
# `send.roleform`. A CNAME forbids other records at its own node, not at names
# under it, so all three resolve; confirmed with dig against the live zone.
CONTACT_FROM=Roleform <contact@roleform.koustubh.org>
# Where support mail is read. An Email Routing alias, so the destination can
# change in Cloudflare without a redeploy. Comma-separated for more than one.
CONTACT_TO=hello@koustubh.org
# Absolute origin, used for the inbox link inside a notification. Falls back to
# Vercel's own production URL, so preview and production are both right unset.
NEXT_PUBLIC_APP_URL=

# The addresses the contact page publishes for writing to us by hand. Unset
# falls back to the three Cloudflare-routed aliases (lib/mail/addresses.ts) —
# set these only when this deployment owns a different domain.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_CATALOG_EMAIL=

# --- Flags -------------------------------------------------------------------
# Demo affordances on the JD screen ship behind this, never in production UI.
NEXT_PUBLIC_DEV_AFFORDANCES=false

# --- Search & AI visibility (lib/seo, docs/seo-strategy.md) ---
# Canonical origin used in sitemaps, canonical tags, JSON-LD and llms.txt.
# NEXT_PUBLIC_APP_URL (above) is reused; set it to https://roleform.koustubh.org in production.
# Google Search Console HTML-tag verification token (content="…" value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools msvalidate.01 token.
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# IndexNow key (8–128 hex chars); served at /indexnow.txt, used by `pnpm seo:indexnow`.
INDEXNOW_KEY=
